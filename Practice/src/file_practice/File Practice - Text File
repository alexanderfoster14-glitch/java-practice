		remainingBenches = 340;
		System.out.println("Started with: " + remainingBenches);

      while (dataFS.hasNextInt()) {
         benchCount = dataFS.nextInt();

         System.out.println(benchCount);
			remainingBenches = remainingBenches - benchCount;
      }

      if (dataFS.hasNext()) {
         System.out.println("Reading stopped at " + dataFS.next());
      }
      else {
         System.out.println("Reached end of file");
      }

		System.out.println("Remaining: " + remainingBenches);

      fileByteStream.close();
   }
}

