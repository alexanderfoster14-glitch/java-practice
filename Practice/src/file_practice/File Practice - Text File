	import java.util.regex.Pattern;
	
	Pattern pattern; //declare the variable

	public void setRegex(String regex) {
		this.regex = regex;
		this.pattern = Pattern.compile(regex);
	}
	
	public boolean searchText(String text) {
		return (this.getRegex() == null) ? true : this.pattern.matcher(text).matches();
	}
	
.matches() requires the ENTIRE string to match perfectly
.find() allows for finding a match someonewhere in the string

example:

	Pattern.compile("x").matcher("example").matches() = false
	Pattern.compile("x").matcher("example").find() = true

Regular Expression syntax
