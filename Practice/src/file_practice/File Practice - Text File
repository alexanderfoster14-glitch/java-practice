Doubles boxHeight and boxWeight are read from input. Output the following:

	boxHeight with a +/- sign, 0's as padding, a minimum of 8 characters, and 3 digits following the decimal point.
	boxWeight left-aligned, a minimum of 7 characters, and 3 digits following the decimal point.
	End each output with a newline.

Ex: If the input is 6.875 4.375, then the output is:
	+006.875
	4.375 

import java.util.Scanner;

public class NumFormatter {
   public static void main(String[] args) {
      Scanner scnr = new Scanner(System.in);
      double boxHeight;
      double boxWeight;
      
      boxHeight = scnr.nextDouble();
      boxWeight = scnr.nextDouble();

      System.out.printf("%+08.3f\n", boxHeight);
      System.out.printf("%-7.3f\n", boxWeight);

   }
}

