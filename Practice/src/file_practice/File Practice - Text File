	public boolean searchFileJava7(File file) throws IOException {
		List<String> lines = Files.readAllLines(file.toPatch(), StandardCharsets.UTF_8);
		for (String line: lines) {
			if (searchText(line)) {
				return true;
			}
		}
		return false;
	}

