derived/base class reference conversion

references to derived class can be converted to references to base classes without the need to be cast

The JVM determines as run time which class should be called based on the object type

----------------------------------------------------------------------------------------------------

CallEmployee.java
import java.util.ArrayList;

public class CallEmployee {
   public static void main(String[] args) {
      Employee person1;
      Professor person2;
      Coach person3;

      ArrayList<Employee> personList = new ArrayList<Employee>();
      int i;

      person1 = new Employee();
      person1.setName("Amy");

      person2 = new Professor();
      person2.setName("Aja");
      person2.setSubject("Art");

      person3 = new Coach();
      person3.setName("Cora");
      person3.setSport("basketball");

      personList.add(person1);
      personList.add(person3);
      personList.add(person2);

      for(i = 0; i < personList.size(); ++i){
         personList.get(i).printInfo();
      }
   }
}

