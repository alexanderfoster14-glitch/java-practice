Overriding

"@" at the beginning on a line creates an annotation
	annotation give the compiler instructions

@Override
	A derived class wtih this annotation will Override the Base class's method
	The child class does the stuff instead of the parent class

----------------------------------------------------------------------------------------------------------

// Business.java	//parent class
public class Business {
   protected String name;
   protected String address;
   ... 

   public String getDescription() {
      return name + " -- " + address;
   }
}

// Restaurant.java	//Child class
public class Restaurant extends Business {
   private int rating;
   ...
   
   @Override
   public String getDescription() {
      return name + " -- " + address +
         "\n  Rating: " + rating;
   }
}
// OverridingExample 
public class OverridingExample {
   public static void main(String[] args) {
      Restaurant favoritePlace = new Restaurant();
      favoritePlace.setName("Friends Cafe");
      favoritePlace.setAddress("500 W 2nd Ave");
      favoritePlace.setRating(5);
      System.out.println(favoritePlace.getDescription());
   }
}

