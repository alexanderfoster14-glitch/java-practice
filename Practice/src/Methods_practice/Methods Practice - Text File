Example about the geometry of Cones


calculateBaseArea() has one double parameter as a cone's radius.
The method returns the area of the cone's base as a double.
The area of the base is calculated by: Area = Pi * radius squared

calculateVolume() has two double parameters as a cone's radius and height.
The method returns the cone's volume as a double, and uses the
	calculateBaseArea() method to calculate the cone's base area.
The volume is calculated by: base area * height * 1.0/3.0

Math.PI for the value of Pi


import java.util.Scanner;
import java.lang.Math;

public class ConeCalculations {

   public static double calculateBaseArea(double coneRadius) {
      return Math.PI * coneRadius * coneRadius;
   }
   
   public static double calculateVolume(double coneRadius, double coneHeight) {
      return calculateBaseArea(coneRadius) * coneHeight * (1.0/3.0);
   }

   public static void main(String[] args) {
      Scanner scan = new Scanner(System.in);
      double coneRadius;
		double coneHeight;
      
      coneRadius = scan.nextDouble();
		coneHeight = scan.nextDouble();
      
      System.out.println("Cone radius: " + coneRadius);
		System.out.println("Cone height: " + coneHeight);
      System.out.printf("Base area: %.1f\n", calculateBaseArea(coneRadius));
      System.out.printf("Volume: ");
      System.out.printf("%.1f\n", calculateVolume(coneRadius, coneHeight));
   }
}

