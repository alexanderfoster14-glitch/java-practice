import java.util.Scanner;
import java.util.InputMismatchException;

public class ExpirationMonth {
   public static void main(String[] args) {
      Scanner scnr = new Scanner(System.in);
      int expirationMonth;
      boolean tryAgain = true;

      while (tryAgain) {
         try {
            expirationMonth = scnr.nextInt();

            if ((expirationMonth < 1) || (expirationMonth > 12)) {
               throw new Exception("Expiration month must be between 1 and 12");
            }

            tryAgain = false;
            System.out.print("Valid input: ");
            System.out.println("Expiration month is " + expirationMonth);
         }

         catch (InputMismatchException e) {
            System.out.println("Fatal error: The ExpirationMonth program quits");
            tryAgain = false;
         }
         
         catch (Exception e) {
            System.out.println(e.getMessage());
         }

      }
   }
}

