Check if an expected string input matches a specific string and count number of times.
	Example:
		stringToFind = "Time"
		Input = "First Mine Time Time Time End"
		Output = 3

import java.util.Scanner;

public class While_practice {
	public static void main(String[] args) {
		Scanner scnr = new Scanner(System.in);
		
		String stringToFind;
		String nextString;
		int wordCount = 0;
		
		System.out.print("Enter the word to count (enter \"End\" to quit): ");
		stringToFind = scnr.next();
		
		System.out.print("Enter first word: ");
		nextString = scnr.next();
		
		while (!nextString.equals("End")) {
			if (nextString.equals(stringToFind)) {
				wordCount++;
			}
			System.out.print("Enter next word: ");
			nextString = scnr.next();
		}
		
		System.out.println(stringToFind + " occurs " + wordCount + " times.");
	}
}

