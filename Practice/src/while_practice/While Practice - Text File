Example to find the greatest common divisor of 2 numbers

Out put the GCD of numA and numB

import java.util.Scanner;

public class While_practice {
	public static void main(String[] args) {
		Scanner scnr = new Scanner(System.in);
		int numA;
		int numB;
		
		System.out.print("Enter the 1st positive integer: ");
		numA = scnr.nextInt();
		
		System.out.print("Enter the 2nd positive integer: ");
		numB = scnr.nextInt();
		
		
		while (numA != numB) {
			if (numA > numB) {
				numA = numA - numB;
			}
			else {
				numB = numB - numA;
			}
		}
		System.out.println("GCD is: " + numA);
	}
}

