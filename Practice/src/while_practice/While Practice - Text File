	Integer userNum is read from input.
	Write a while loop that iterates while userNum is non-negative.
	In each iteration:
		Update integer finalVal as follows:
		If userNum is divisible by 3, subtract userNum from finalVal.
		Otherwise, add userNum to finalVal.
		Then, read the next integer from input into variable userNum.

import java.util.Scanner;

public class While_practice {
	
	public static void main(String[] args) {
		Scanner scnr = new Scanner(System.in);
		int userNum;
		int finalVal;
		
		finalVal = 0;
		userNum = scnr.nextInt();
		
		while (userNum >= 0) {
			if (userNum % 3 == 0) {
				finalVal = finalVal - userNum;
			} else {
				finalVal = finalVal + userNum;
			}
			userNum = scnr.nextInt();
		}
	}
}


