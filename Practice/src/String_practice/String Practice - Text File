Create a 2-letter domain name list
Two-letter domain names:
aa.com
ab.com
...
zx.com
zy.com
zz.com

import java.util.Scanner;

public class DomainNamePrinter {

   public static void main(String[] args) {
      char letter1;
      char letter2;

      System.out.println("Two-letter domain names:");

      letter1 = 'a';
      while (letter1 <= 'z') {
         letter2 = 'a';
         while (letter2 <= 'z') {
            System.out.println("" + letter1 + "" + letter2 + ".com");
            ++letter2;
         }
         ++letter1;
      }
   }
}


